# Application Configuration
PROJECT_NAME="Resume Skill Evidence Extraction & Gap Analysis Platform"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"  # Options: development, staging, production

# Security & Authentication
# CRITICAL: In production or staging, SECRET_KEY MUST be set and at least 32 characters long.
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="replace-this-with-a-secure-random-32-character-secret-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (sliding window per client IP)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3

# Database Configuration
# SQLite persistent file path (default):
DATABASE_URL="sqlite:///./data/platform.db"
# PostgreSQL production example:
# DATABASE_URL="postgresql://db_user:db_password@localhost:5432/resume_platform"

# Storage & Upload Constraints
DATA_DIR="./data"
STORAGE_DIR="./storage/resumes"
MAX_FILE_SIZE_MB=15
MAX_PDF_PAGES=15

# CORS Allowed Origins (comma-separated for production)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Seeding & Demo Data
# In production, set SEED_DEMO_DATA=false so test candidates are NOT seeded.
SEED_DEMO_DATA=false
# Admin user is only seeded if both email and password are provided:
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
